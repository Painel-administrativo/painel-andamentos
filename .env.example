# Credenciais do Supabase — copie para .env e preencha com seus próprios valores
# Nunca commite o arquivo .env real no Git.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
AUTH_ORIGIN=https://your-production-domain.example
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_ID=replace-with-confirmed-supabase-user-id
# Generate independently; never reuse or publish real values.
AUTH_SESSION_SECRET=replace-with-64-hex-characters
AUTH_AUTOMATION_TOKEN=replace-with-at-least-43-random-characters
